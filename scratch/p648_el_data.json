\\\"reg-step-header\\\">\\r\\n              <span class=\\\"reg-step-num\\\">05<\\/span>\\r\\n              <div class=\\\"reg-step-icon\\\" aria-hidden=\\\"true\\\">\\r\\n                <svg viewBox=\\\"0 0 24 24\\\" width=\\\"24\\\" height=\\\"24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"\\r\\n                  stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\\r\\n                  <polygon\\r\\n                    points=\\\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\\\">\\r\\n                  <\\/polygon>\\r\\n                <\\/svg>\\r\\n              <\\/div>\\r\\n            <\\/div>\\r\\n            <h3 class=\\\"reg-step-title\\\">Step 5: Start Your Host Journey<\\/h3>\\r\\n            <p class=\\\"reg-step-desc\\\">\\r\\n              Once your host application and verification are approved, you can begin using your BoloUp Host account and\\r\\n              start building your live audience.\\r\\n            <\\/p>\\r\\n          <\\/div>\\r\\n\\r\\n        <\\/div>\\r\\n      <\\/div>\\r\\n    <\\/div>\\r\\n  <\\/section>\\r\\n\\r\\n  <!-- FAQs Section -->\\r\\n  <section class=\\\"section section-white\\\" id=\\\"faqs\\\">\\r\\n    <div class=\\\"container\\\">\\r\\n      <div class=\\\"section-title-wrap\\\">\\r\\n        <div class=\\\"section-badge\\\">Got Questions?<\\/div>\\r\\n        <h2 class=\\\"section-title\\\">Frequently Asked Questions<\\/h2>\\r\\n      <\\/div>\\r\\n\\r\\n      <div class=\\\"faq-accordion\\\" id=\\\"host-faq-accordion\\\">\\r\\n        <!-- FAQ 1 -->\\r\\n        <div class=\\\"faq-item\\\" id=\\\"faq-item-1\\\">\\r\\n          <button type=\\\"button\\\" class=\\\"faq-question\\\" id=\\\"faq-btn-1\\\" aria-expanded=\\\"false\\\" aria-controls=\\\"faq-ans-1\\\">\\r\\n            <span class=\\\"faq-q-text\\\">\\r\\n              <span class=\\\"faq-q-num\\\">Q1<\\/span>\\r\\n              <span>What does a BoloUp App Host do?<\\/span>\\r\\n            <\\/span>\\r\\n            <span class=\\\"faq-icon\\\" aria-hidden=\\\"true\\\">+<\\/span>\\r\\n          <\\/button>\\r\\n          <div class=\\\"faq-answer\\\" id=\\\"faq-ans-1\\\" role=\\\"region\\\" aria-labelledby=\\\"faq-btn-1\\\">\\r\\n            <div class=\\\"faq-answer-inner\\\">\\r\\n              <p>\\r\\n                A BoloUp App Host creates live content and interacts with viewers in real time. Hosts can chat,\\r\\n                entertain, share their interests, build an audience, and receive virtual gifts during their live\\r\\n                sessions.\\r\\n              <\\/p>\\r\\n            <\\/div>\\r\\n          <\\/div>\\r\\n        <\\/div>\\r\\n\\r\\n        <!-- FAQ 2 -->\\r\\n        <div class=\\\"faq-item\\\" id=\\\"faq-item-2\\\">\\r\\n          <button type=\\\"button\\\" class=\\\"faq-question\\\" id=\\\"faq-btn-2\\\" aria-expanded=\\\"false\\\" aria-controls=\\\"faq-ans-2\\\">\\r\\n            <span class=\\\"faq-q-text\\\">\\r\\n              <span class=\\\"faq-q-num\\\">Q2<\\/span>\\r\\n              <span>Do I need to join an agency to become a BoloUp Host?<\\/span>\\r\\n            <\\/span>\\r\\n            <span class=\\\"faq-icon\\\" aria-hidden=\\\"true\\\">+<\\/span>\\r\\n          <\\/button>\\r\\n          <div class=\\\"faq-answer\\\" id=\\\"faq-ans-2\\\" role=\\\"region\\\" aria-labelledby=\\\"faq-btn-2\\\">\\r\\n            <div class=\\\"faq-answer-inner\\\">\\r\\n              <p>\\r\\n                The current host-registration process includes entering an Agency ID when joining as a host. An agency\\r\\n                can also provide support and guidance as you get started on the platform.\\r\\n              <\\/p>\\r\\n            <\\/div>\\r\\n          <\\/div>\\r\\n        <\\/div>\\r\\n\\r\\n        <!-- FAQ 3 -->\\r\\n        <div class=\\\"faq-item\\\" id=\\\"faq-item-3\\\">\\r\\n          <button type=\\\"button\\\" class=\\\"faq-question\\\" id=\\\"faq-btn-3\\\" aria-expanded=\\\"false\\\" aria-controls=\\\"faq-ans-3\\\">\\r\\n            <span class=\\\"faq-q-text\\\">\\r\\n              <span class=\\\"faq-q-num\\\">Q3<\\/span>\\r\\n              <span>How does a BoloUp Host earn money?<\\/span>\\r\\n            <\\/span>\\r\\n            <span class=\\\"faq-icon\\\" aria-hidden=\\\"true\\\">+<\\/span>\\r\\n          <\\/button>\\r\\n          <div class=\\\"faq-answer\\\" id=\\\"faq-ans-3\\\" role=\\\"region\\\" aria-labelledby=\\\"faq-btn-3\\\">\\r\\n            <div class=\\\"faq-answer-inner\\\">\\r\\n              <p>\\r\\n                Hosts can receive virtual gifts from viewers during live sessions. Eligible earnings and any additional\\r\\n                host rewards depend on current BoloUp and agency program requirements.\\r\\n              <\\/p>\\r\\n            <\\/div>\\r\\n          <\\/div>\\r\\n        <\\/div>\\r\\n      <\\/div>\\r\\n    <\\/div>\\r\\n  <\\/section>\\r\\n\\r\\n  <!-- Final CTA Section -->\\r\\n  <section class=\\\"section section-dark cta-section-wrapper\\\" id=\\\"cta\\\">\\r\\n    <div class=\\\"container\\\">\\r\\n      <div class=\\\"cta-banner-epic\\\">\\r\\n        <div class=\\\"cta-glow-element top-left\\\" aria-hidden=\\\"true\\\"><\\/div>\\r\\n        <div class=\\\"cta-glow-element bottom-right\\\" aria-hidden=\\\"true\\\"><\\/div>\\r\\n\\r\\n        <div class=\\\"cta-content-inner\\\">\\r\\n          <h2 class=\\\"cta-title\\\">Ready to Start Going Live on BoloUp?<\\/h2>\\r\\n          <div class=\\\"cta-actions\\\">\\r\\n            <a href=\\\"#registration\\\" class=\\\"btn btn-primary btn-lg\\\" id=\\\"final-cta-host\\\">\\r\\n              Join as a BoloUp Host\\r\\n            <\\/a>\\r\\n          <\\/div>\\r\\n        <\\/div>\\r\\n      <\\/div>\\r\\n    <\\/div>\\r\\n  <\\/section>\\r\\n\\r\\n  <!-- Internal JavaScript (Strictly inside body before closing tag) -->\\r\\n  <script>\\r\\n    \\/\\/ Copy Agency ID to Clipboard Function\\r\\n    function copyAgencyId() {\\r\\n      const agencyCode = '2527626';\\r\\n      const btn = document.getElementById('btn-copy-agency-id');\\r\\n      const label = document.getElementById('copy-btn-label');\\r\\n      const toast = document.getElementById('copy-feedback-toast');\\r\\n\\r\\n      function showSuccess() {\\r\\n        if (btn) btn.classList.add('copied');\\r\\n        if (label) label.textContent = 'Copied!';\\r\\n        if (toast) toast.classList.add('show');\\r\\n\\r\\n        setTimeout(function () {\\r\\n          if (btn) btn.classList.remove('copied');\\r\\n          if (label) label.textContent = 'Copy ID';\\r\\n          if (toast) toast.classList.remove('show');\\r\\n        }, 2500);\\r\\n      }\\r\\n\\r\\n      if (navigator.clipboard && window.isSecureContext) {\\r\\n        navigator.clipboard.writeText(agencyCode).then(showSuccess).catch(function () {\\r\\n          fallbackCopyText(agencyCode);\\r\\n          showSuccess();\\r\\n        });\\r\\n      } else {\\r\\n        fallbackCopyText(agencyCode);\\r\\n        showSuccess();\\r\\n      }\\r\\n    }\\r\\n\\r\\n    function fallbackCopyText(text) {\\r\\n      const textArea = document.createElement('textarea');\\r\\n      textArea.value = text;\\r\\n      textArea.style.position = 'fixed';\\r\\n      textArea.style.top = '-9999px';\\r\\n      textArea.style.left = '-9999px';\\r\\n      document.body.appendChild(textArea);\\r\\n      textArea.focus();\\r\\n      textArea.select();\\r\\n      try {\\r\\n        document.execCommand('copy');\\r\\n      } catch (err) {\\r\\n        console.error('Fallback copy error:', err);\\r\\n      }\\r\\n      document.body.removeChild(textArea);\\r\\n    }\\r\\n\\r\\n    \\/\\/ FAQ Accordion Interaction\\r\\n    (function () {\\r\\n      const faqButtons = document.querySelectorAll('.faq-question');\\r\\n      faqButtons.forEach(function (button) {\\r\\n        button.addEventListener('click', function () {\\r\\n          const item = this.parentElement;\\r\\n          const answer = item.querySelector('.faq-answer');\\r\\n          const isExpanded = this.getAttribute('aria-expanded') === 'true';\\r\\n\\r\\n          \\/\\/ Close other open FAQ items\\r\\n          document.querySelectorAll('.faq-item').forEach(function (otherItem) {\\r\\n            if (otherItem !== item && otherItem.classList.contains('active')) {\\r\\n              otherItem.classList.remove('active');\\r\\n              const otherBtn = otherItem.querySelector('.faq-question');\\r\\n              const otherAns = otherItem.querySelector('.faq-answer');\\r\\n              if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');\\r\\n              if (otherAns) otherAns.style.maxHeight = null;\\r\\n            }\\r\\n          });\\r\\n\\r\\n          \\/\\/ Toggle current\\r\\n          if (isExpanded) {\\r\\n            item.classList.remove('active');\\r\\n            this.setAttribute('aria-expanded', 'false');\\r\\n            if (answer) answer.style.maxHeight = null;\\r\\n          } else {\\r\\n            item.classList.add('active');\\r\\n            this.setAttribute('aria-expanded', 'true');\\r\\n            if (answer) answer.style.maxHeight = answer.scrollHeight + 'px';\\r\\n          }\\r\\n        });\\r\\n      });\\r\\n    })();\\r\\n\\r\\n    \\/\\/ Smooth scroll for anchor links\\r\\n    (function () {\\r\\n      document.querySelectorAll('a[href^=\\\"#\\\"]').forEach(function (anchor) {\\r\\n        anchor.addEventListener('click', function (e) {\\r\\n          const targetId = this.getAttribute('href');\\r\\n          if (targetId && targetId !== '#') {\\r\\n            const targetEl = document.querySelector(targetId);\\r\\n            if (targetEl) {\\r\\n              e.preventDefault();\\r\\n              targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });\\r\\n            }\\r\\n          }\\r\\n        });\\r\\n      });\\r\\n    })();\\r\\n  <\\/script>\"},\"elements\":[],\"widgetType\":\"html\"}],\"isInner\":false}]",
